# ===================== OJ 判题沙箱 =====================
# 本文件是环境变量模板。项目不自动加载 .env（app.py 直接读 os.environ），
# 请复制为 .env 后手动 export，或写入启动脚本（启动服务器.bat / 启动服务器.sh）。

# 沙箱临时目录的父目录：判题时在这里面建独立临时目录，跑完立刻删除。
# Linux/macOS 默认 /tmp/oj_sandbox；Windows 默认 %TEMP%\oj_sandbox。
SANDBOX_WORK_ROOT=/tmp/oj_sandbox

# 判题最大并发数。超出排队等待，不拒绝（旧实现会直接回退按空给分，会误伤）。
SANDBOX_MAX_CONCURRENCY=4

# 降权运行的用户/组（仅 Linux 且以 root 启动时生效，见 README「OJ 安全」）。
# 建议先建专用低权限用户：useradd -r -m -s /bin/bash ojrunner
SANDBOX_UID=
SANDBOX_GID=

# 判题内存上限（KB，地址空间，仅 POSIX 下 ulimit -v 生效）。
# 注意这是「地址空间」不是物理内存；Python 建议不低于 256000（256MB）。
OJ_MEM_LIMIT_KB=512000
